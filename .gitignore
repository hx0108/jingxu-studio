# Dependencies and package-manager caches
node_modules/
.pnpm-store/

# Build and test outputs
dist/
out/
apps/desktop/out*/
release/
coverage/
playwright-report/
test-results/
.vite/
.cache/
*.tsbuildinfo

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Local databases and SQLite sidecars
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# FFmpeg runtime binaries are pinned by apps/desktop/resources/ffmpeg/ffmpeg-manifest.json
# (source URL + SHA-256). Fetch per the manifest; package:win fails closed if absent.
apps/desktop/resources/ffmpeg/*.exe

# Secrets and local environment overrides
.env
.env.*
!.env.example
!.env.*.example

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
